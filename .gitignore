# Local environment and credentials
.env
.env.*
!.env.example

# Python environments and caches
.venv/
venv/
backend/.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
coverage/
htmlcov/

# Frontend dependencies and output
node_modules/
.next/
*.tsbuildinfo

# Databases, dumps, archives, certificates, and private keys
*.db
*.db*
*.sqlite
*.sqlite3
*.dump
*.rdb
*.zip
*.tar
*.tar.gz
*.pem
*.key
*.pfx
*.p12
*.crt
*.cer

# Operational and private artifacts
reports/
logs/
tmp/
temp/
backups/
recovery/
evidence/
data/backups/
data/audit_archives/
data/evidence/
data/evidence_workspace/
data/reports/
data/process-state/
data/cache/*
backend/data/

# Operator imports are private by default; retain only public templates/fixtures.
data/imports/*
!data/imports/*.example
!data/imports/*-template.csv
!data/imports/GP.csv

# Keep empty public directory placeholders.
!data/cache/.gitkeep
!data/reports/.gitkeep
!data/backups/.gitkeep
